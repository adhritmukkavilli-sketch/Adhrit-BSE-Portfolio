# ZMPSHOW - prints one line of "show your work" text.
# Input : Str0 = text. A leading "*" marks a final answer, which is
#         shown even when SHOW WORK is turned off.
# Uses  : θ = lines on screen so far (callers reset it to 0 after ClrHome)
#         ʟMPSET(1) show work on/off, ʟMPSET(2) pace 1=page 2=line,
#         ʟMPSET(5) answer flag, ʟMPSET(8) scratch
sub(Str0,1,1)="*"→ʟMPSET(5)
If ʟMPSET(5)
sub(Str0,2,length(Str0)-1)→Str0
If ʟMPSET(5) or ʟMPSET(1)
Then
  Repeat not(length(Str0))
    If θ≥9
    Then
      Pause
      ClrHome
      0→θ
    End
    If length(Str0)≤25
    Then
      Disp Str0
      ""→Str0
    Else
      # wrap at the last space that fits; continue on the next line
      27→ʟMPSET(8)
      Repeat ʟMPSET(8)<12 or sub(Str0,ʟMPSET(8),1)=" "
        ʟMPSET(8)-1→ʟMPSET(8)
      End
      If ʟMPSET(8)<12
      26→ʟMPSET(8)
      Disp sub(Str0,1,ʟMPSET(8)-1)
      If sub(Str0,ʟMPSET(8),1)=" "
      Then
        If ʟMPSET(8)=length(Str0)
        Then
          ""→Str0
        Else
          " "+sub(Str0,ʟMPSET(8)+1,length(Str0)-ʟMPSET(8))→Str0
        End
      Else
        sub(Str0,ʟMPSET(8),length(Str0)-ʟMPSET(8)+1)→Str0
      End
    End
    θ+1→θ
  End
  If ʟMPSET(2)=2 and not(ʟMPSET(5)) and θ<9
  Pause
End
